Bounds GetPatchBounds(RenderPatch patch){
    float halfSize = GetPatchExtent(patch.lod);
    // #if ENABLE_SEAM
    // halfSize *= 0.9;
    // #endif
    Bounds bounds;
    float3 boundsMin,boundsMax;
    boundsMin.xz = patch.position - halfSize;
    boundsMax.xz = patch.position + halfSize;
    boundsMin.y = patch.minMaxHeight.x;
    boundsMax.y = patch.minMaxHeight.y;

    bounds.minPosition = boundsMin;
    bounds.maxPosition = boundsMax;
    return bounds;
}



float3 TransformWorldToUVD(float3 positionWS)
{
    float4 positionHS = mul(_HizCameraMatrixVP, float4(positionWS, 1.0));
    float3 uvd = positionHS.xyz / positionHS.w;
    uvd.xy = uvd.xy * 0.5 + 0.5;
    //点可能跑到摄像机背后去，深度会变成负数，需要特殊处理一下
    // if(uvd.z < 0){

    //     uvd.z = 1;
     
    // }

      uvd.z = max(uvd.z, 0);
    return uvd;
}

float SampleHiz(float2 uv,float mip,float mipTexSize){
    uint2 coord = floor(uv * mipTexSize);
    coord = min(coord,round(mipTexSize)-1);
    return HiZMipMap.mips[mip][coord].r; 
}

float LinearEyeDepth2(float depth){
   return 1.0 / (3.3332330 * depth + 0.0000999);
}


Bounds
    CalBoundUVD(
    float3 minPos, float3 maxPos)
{
    float3 pos0 = float3(minPos.x, minPos.y, minPos.z);
    float3 pos1 = float3(minPos.x, minPos.y, maxPos.z);
    float3 pos2 = float3(minPos.x, maxPos.y, minPos.z);
    float3 pos3 = float3(maxPos.x, minPos.y, minPos.z);
    float3 pos4 = float3(maxPos.x, maxPos.y, minPos.z);
    float3 pos5 = float3(maxPos.x, minPos.y, maxPos.z);
    float3 pos6 = float3(minPos.x, maxPos.y, maxPos.z);
    float3 pos7 = float3(maxPos.x, maxPos.y, maxPos.z);
    
    float3 uvd0 = TransformWorldToUVD(pos0);
    float3 uvd1 = TransformWorldToUVD(pos1);
    float3 uvd2 = TransformWorldToUVD(pos2);
    float3 uvd3 = TransformWorldToUVD(pos3);
    float3 uvd4 = TransformWorldToUVD(pos4);
    float3 uvd5 = TransformWorldToUVD(pos5);
    float3 uvd6 = TransformWorldToUVD(pos6);
    float3 uvd7 = TransformWorldToUVD(pos7);
    
    float3 minPosUVD = min(min(min(uvd0, uvd1), min(uvd2, uvd3)), min(min(uvd4, uvd5), min(uvd6, uvd7)));
    float3 maxPosUVD = max(max(max(uvd0, uvd1), max(uvd2, uvd3)), max(max(uvd4, uvd5), max(uvd6, uvd7)));
    Bounds bound;
    bound.maxPosition = clamp(maxPosUVD, 0, 1);
    bound.minPosition = clamp(minPosUVD, 0, 1);
    return bound;
}


