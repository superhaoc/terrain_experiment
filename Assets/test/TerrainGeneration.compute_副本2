bool IsBoxVisible(float3 center, float3 extents)
{
    for (int i = 0; i < 6; i++)
    {
        float3 normal = _FrustumPlanes2[i].xyz;
        float dist = dot(normal, center) - _FrustumPlanes2[i].w;
        float radius = dot(abs(normal), extents);
        if (dist < -radius) return false;
    }
    return true;
}

int ComputeDesiredLod(float3 worldPos, float nodeSize)
{
    float dist = length(worldPos - _CameraPos);
    return clamp((int)(dist / _LODDistanceFactor), 0, _MaxLod);
}


float GetNodeSize(uint lod){
    return WorldLodParams[lod].x;
}

float GetNodeCount(uint lod){
    return WorldLodParams[lod].z;
}

